POSTGRES_USER=cloudcart
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=cloudcart
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cloudcart:change-this-password@postgres:5432/cloudcart
REDIS_URL=redis://redis:6379/0
CATALOG_URL=http://catalog:8000
IDENTITY_URL=http://identity:8000
CART_URL=http://cart:8000
ORDER_URL=http://order:8000
INVENTORY_URL=http://inventory:8000
PAYMENT_URL=http://payment:8000
NOTIFICATION_URL=http://notification:8000
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=cloudcart_session
SESSION_COOKIE_SECURE=false
ENVIRONMENT=production
API_BASE=/api
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://shop.cloudsystemonline.com
